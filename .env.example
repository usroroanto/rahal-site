# ---------------------------------------------------------------------------
# RAHAL — variables d'environnement (copier ce fichier en `.env`)
# Les variables sans préfixe PUBLIC_ restent strictement côté serveur.
# ---------------------------------------------------------------------------

# URL publique du site (sans barre oblique finale). Sert aux aperçus de partage,
# au sitemap et aux liens absolus.
PUBLIC_SITE_URL=https://www.exemple.fr

# Clé API Brevo (Paramètres > Clés API). Sans cette clé, les formulaires
# affichent un message d'indisponibilité : aucun envoi n'est simulé.
BREVO_API_KEY=

# Adresse et nom d'expéditeur validés dans Brevo (Expéditeurs & IP).
# Nécessaires pour l'envoi du programme par email et pour le formulaire de contact.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RAHAL

# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_TO_EMAIL=

# Facultatif : URL de l'API Brevo (utile uniquement pour les tests locaux).
# BREVO_API_URL=https://api.brevo.com/v3
