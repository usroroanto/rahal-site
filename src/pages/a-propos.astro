---
import Base from '@/layouts/Base.astro';
import Photo from '@/components/Photo.astro';
import Arrow from '@/components/Arrow.astro';
import BrandMark from '@/components/BrandMark.astro';
import Topo from '@/components/Topo.astro';
import { aPropos as copy } from '@/content/pages/a-propos';
---

<Base title={copy.seo.title} description={copy.seo.description}>
  <section class="ahero">
    <Topo class="ahero__topo" />
    <div class="container ahero__inner">
      <div class="ahero__text">
        <p class="kicker">{copy.hero.kicker}</p>
        <h1 class="h-serif">{copy.hero.title}</h1>
        <p class="lede">{copy.hero.text}</p>
      </div>
      <div class="ahero__media">
        <Photo image={copy.hero.portrait} ratio="4 / 5" mobileRatio="1 / 1" rounded priority sizes="(min-width: 76rem) 26rem, (min-width: 64rem) calc(36vw - 2rem), (min-width: 31rem) 28rem, calc(100vw - 2.5rem)" />
      </div>
    </div>
  </section>

  <section class="astory" aria-label="Ce qui a donné naissance à RAHAL">
    <div class="container">
      <div class="astory__grid">
        {
          copy.sections.map((section, i) => (
            <article class="story-card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
              {section.image && (
                <Photo image={section.image} ratio="4 / 5" mobileRatio="4 / 3" rounded sizes="(min-width: 76rem) 360px, (min-width: 64rem) calc(33vw - 3rem), calc(100vw - 2.5rem)" />
              )}
              <div class="story-card__body">
                <p class="kicker">{section.kicker}</p>
                <h2 class="story-card__title">{section.title}</h2>
                <p class="story-card__text">{section.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="aclose on-dark" aria-labelledby="aclose-titre">
    <Topo class="aclose__topo" />
    <div class="container aclose__inner" data-reveal>
      <BrandMark variant="light" height={64} />
      <p class="kicker">{copy.closing.kicker}</p>
      <h2 class="h-serif aclose__title" id="aclose-titre">{copy.closing.title}</h2>
      <p class="aclose__text">{copy.closing.text}</p>
      <a class="btn btn--light" href={copy.closing.button.href}>
        {copy.closing.button.label}
        <Arrow />
      </a>
    </div>
  </section>
</Base>

<style>
  /* Ouverture sur fond sable : texte et portrait. */
  .ahero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(170deg, var(--c-sable-2) 0%, var(--c-sable) 100%);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .ahero :global(.ahero__topo) {
    --topo-opacity: 0.14;
    inset: -20% auto auto -30%;
    width: 85%;
    height: 140%;
  }

  .ahero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .ahero__text {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
  }

  .ahero__media {
    max-width: 26rem;
  }

  /* Trois cartes : photo, puis texte court. */
  .astory {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .astory__grid {
    display: grid;
    gap: 2rem;
  }

  .story-card {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .story-card__body {
    display: grid;
    gap: 0.6rem;
  }

  .story-card__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.7rem, 2.4vw, 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .story-card__text {
    color: var(--c-gris);
    text-wrap: pretty;
  }

  /* Fermeture sur fond vert : la devise et l'appel à l'action. */
  .aclose {
    position: relative;
    overflow: hidden;
    background: var(--c-foret, #254139);
    color: var(--c-ivoire);
    padding-block: clamp(3.5rem, 8vw, 6rem);
    text-align: center;
  }

  .aclose :global(.aclose__topo) {
    --topo-color: var(--c-or);
    --topo-opacity: 0.12;
  }

  .aclose__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.1rem;
  }

  .aclose .kicker {
    color: #e9bd72;
  }

  .aclose__title {
    max-width: 18ch;
  }

  .aclose__text {
    color: #c9d4cc;
    max-width: 34rem;
  }

  .aclose .btn {
    margin-top: 0.5rem;
  }

  /* Tablette : chaque carte en ligne (photo à gauche, texte à droite) plutôt qu'une grille à trou. */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .story-card {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .ahero__inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 5rem;
    }

    .ahero__media {
      justify-self: end;
      width: 100%;
    }

    .astory__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
</style>
