---
import Base from '@/layouts/Base.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Photo from '@/components/Photo.astro';
import Topo from '@/components/Topo.astro';
import WaitlistForm from '@/components/forms/WaitlistForm.astro';
import { experiences } from '@/content/experiences';
import { experiencesPage as copy } from '@/content/pages/experiences';
import { resolveImage } from '@/lib/images';
import { getImage } from 'astro:assets';

const single = experiences.length === 1;
// Fond flouté : la photo de la première expérience, en petite taille (le flou masque la résolution).
const bgMeta = experiences[0] ? resolveImage(experiences[0].card.src) : undefined;
const bg = bgMeta ? await getImage({ src: bgMeta, width: 480, format: 'webp', quality: 60 }) : undefined;
---

<Base title={copy.seo.title} description={copy.seo.description}>
  <section class="intro">
    <Topo class="intro__topo" />
    <div class="container intro__inner">
      <SectionHead kicker={copy.kicker} title={copy.title} lede={copy.text} level="h1" serif />
      <ul class="intro__mosaic" role="list">
        {copy.mosaic.map((tile, i) => (
          <li class="intro__tile">
            <Photo image={tile.image} ratio="3 / 4" rounded priority={i === 0} sizes="(min-width: 64rem) 12rem, 30vw" />
            <span class="intro__tile-label" aria-hidden="true">{tile.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="list section" aria-label="Expériences disponibles">
    {bg && <img class="list__bg" src={bg.src} alt="" aria-hidden="true" width="480" height="640" loading="eager" decoding="async" />}
    <div class="list__veil" aria-hidden="true"></div>
    <div class="container list__inner">
      <div class:list={['list__grid', { 'list__grid--single': single }]}>
        {experiences.map((exp, i) => <ExperienceCard experience={exp} variant={single ? 'feature' : 'grid'} headingLevel="h2" priority={i === 0} />)}
      </div>

      <aside class="next on-dark" aria-labelledby="next-titre" data-reveal>
        <div class="next__media">
          <Photo image={copy.next.image} fill sizes="(min-width: 64rem) 30rem, calc(100vw - 2.5rem)" />
        </div>
        <div class="next__body">
          <div class="next__text">
            <p class="kicker">{copy.next.kicker}</p>
            <h2 class="next__title" id="next-titre">{copy.next.title}</h2>
            <p>{copy.next.text}</p>
          </div>
          <WaitlistForm tone="dark" />
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .intro :global(.intro__topo) {
    --topo-opacity: 0.1;
    inset: -30% -20% auto auto;
    width: 70%;
    height: 160%;
  }

  .intro__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  /* Trois photos qui illustrent le titre : un pays, une pratique, un petit groupe. */
  .intro__mosaic {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .intro__tile {
    position: relative;
  }

  .intro__tile:nth-child(2) {
    translate: 0 1.25rem;
  }

  .intro__tile-label {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-pill);
    background: rgb(34 33 31 / 0.72);
    color: var(--c-ivoire);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(6px);
  }

  .intro :global(.section-head) {
    margin-bottom: 0;
    max-width: 48rem;
  }

  /* Fond flouté qui habille les côtés de la carte. */
  .list {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-sable);
  }

  .list__bg {
    position: absolute;
    inset: -8%;
    z-index: -2;
    width: 116%;
    height: 116%;
    max-width: none;
    object-fit: cover;
    object-position: center 45%;
    filter: blur(42px) saturate(1.05);
    opacity: 0.85;
  }

  .list__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 50% 40%, rgb(232 221 204 / 0.35) 0%, rgb(232 221 204 / 0.7) 70%),
      linear-gradient(180deg, rgb(247 243 235 / 0.35), rgb(232 221 204 / 0.55));
  }

  .list__inner {
    position: relative;
  }

  .list__grid {
    display: grid;
    gap: 1.5rem;
  }

  /* Liste d'attente : photo d'un chemin sous les glycines, panneau vert forêt. */
  .next {
    display: grid;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
    border-radius: var(--r-l);
    background: var(--c-foret);
    color: var(--c-ivoire);
    box-shadow: var(--shadow-m);
  }

  .next__media {
    position: relative;
    min-height: 13rem;
  }

  .next__body {
    display: grid;
    gap: 1.5rem;
    align-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .next__text {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .next__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1.05;
  }

  .next__text p:not(.kicker) {
    color: #d7e0d9;
    max-width: 30rem;
  }

  /* Petits écrans : étiquettes compactes, sur une ligne. */
  @media (max-width: 29.99rem) {
    .intro__tile-label {
      left: 0.4rem;
      right: 0.4rem;
      bottom: 0.4rem;
      padding: 0.25rem 0.4rem;
      border-radius: var(--r-s);
      font-size: 0.66rem;
      line-height: 1.25;
      text-align: center;
    }
  }

  @media (min-width: 64rem) {
    .intro__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }

    .intro__mosaic {
      gap: 1rem;
    }

    .list__grid:not(.list__grid--single) {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }

    .next {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .next__media {
      min-height: 100%;
    }
  }
</style>
