---
import Base from '@/layouts/Base.astro';
import Arrow from '@/components/Arrow.astro';
import { accueil } from '@/content/pages/accueil';
import { featuredExperience } from '@/content/experiences';
const next = featuredExperience;
---

<Base title="RAHAL — Partir ailleurs. Revenir avec plus." description="Des voyages à taille humaine pour apprendre une pratique, explorer un pays et partager l’aventure. Prochain départ : la Chine, en janvier 2027.">
  <section class="brand-hero container" aria-labelledby="brand-title">
    <div class="brand-copy">
      <p class="kicker">RAHAL · Voyages à taille humaine</p>
      <h1 id="brand-title">Partir ailleurs.<br /><em>Revenir<br class="desktop-break" /> avec plus.</em></h1>
      <p class="brand-lede">Une pratique à apprendre. Un pays à explorer.<br />Des gens avec qui vivre tout ça.</p>
      <p class="brand-intro">RAHAL, c’est le goût de découvrir en faisant. Des voyages où l’on essaie, où l’on rencontre, où l’on sort de ses habitudes — ensemble.</p>
      <div class="brand-actions"><a class="btn" href="#prochain-depart">Découvrir le prochain voyage <Arrow /></a><a class="brand-link" href="/a-propos">L’esprit RAHAL</a></div>
      <p class="brand-signature"><span aria-hidden="true">✳</span> Apprendre. Essayer. Se dépasser.</p>
    </div>
    {next && <a class="travel-poster" href={`/experiences/${next.slug}`} aria-label={`Découvrir notre prochain voyage en ${next.country}`}>
      <div class="poster-top"><span>Le prochain chapitre</span><span>01 / RAHAL</span></div>
      <div class="poster-title">{next.country}<em>à vivre.</em></div>
      <svg class="poster-art" viewBox="0 0 500 400" aria-hidden="true" focusable="false">
        <circle cx="350" cy="100" r="76" fill="#dbab58" />
        <g fill="none" stroke="#f2e8d5" stroke-width="1.3" opacity=".4">
          <path d="M-20 240 Q90 60 175 215 T360 185 T520 185" /><path d="M-20 258 Q90 78 175 233 T360 203 T520 203" /><path d="M-20 276 Q90 96 175 251 T360 221 T520 221" /><path d="M-20 294 Q90 114 175 269 T360 239 T520 239" /><path d="M-20 312 Q90 132 175 287 T360 257 T520 257" /><path d="M-20 330 Q90 150 175 305 T360 275 T520 275" />
        </g>
        <path d="M85 156 C310 100 70 360 380 320" fill="none" stroke="#e9bd72" stroke-width="2" stroke-dasharray="4 8" />
        <g fill="#f7f3eb" stroke="#254139" stroke-width="5"><circle cx="85" cy="156" r="8"/><circle cx="204" cy="256" r="8"/><circle cx="380" cy="320" r="8"/></g>
        <g fill="#f7f3eb" font-family="sans-serif" font-size="15" letter-spacing="2"><text x="55" y="135">PÉKIN</text><text x="220" y="248">KUNG-FU</text><text x="287" y="355">SHANGHAI</text></g>
      </svg>
      <div class="poster-bottom"><span>Janvier 2027</span><span>{next.duration} <span aria-hidden="true">↗</span></span></div>
    </a>}
  </section>
  <div class="brand-ribbon" aria-label="L’esprit de nos voyages"><span>La curiosité comme point de départ.</span><span aria-hidden="true">✳</span><span>Le groupe comme compagnon de route.</span></div>
  <section class="manifesto container section" aria-labelledby="manifesto-title">
    <div class="section-intro"><p class="kicker">La façon RAHAL</p><h2 id="manifesto-title">Un voyage se regarde.<br /><em>Une aventure se vit.</em></h2></div>
    <div class="brand-pillars">
      <article><span class="chapter-number">01</span><h3>Apprendre sur place.</h3><p>Découvrir une pratique avec celles et ceux qui la vivent. Prendre le temps de s’y essayer et repartir avec quelque chose en soi.</p></article>
      <article><span class="chapter-number">02</span><h3>Explorer pour de vrai.</h3><p>Marcher dans une ville inconnue, goûter, échanger, se laisser surprendre. Garder de la place pour ce qu’on n’avait pas prévu.</p></article>
      <article><span class="chapter-number">03</span><h3>Le vivre ensemble.</h3><p>Des compagnons de route pour partager les découvertes et les efforts. Pas besoin de connaître tout le monde pour avoir envie de partir.</p></article>
    </div>
  </section>
  {next && <section class="next-trip section" id="prochain-depart" aria-labelledby="next-title"><div class="container next-grid">
    <div class="next-heading"><p class="kicker">Notre prochain départ</p><h2 id="next-title">La Chine.<br /><em>Trois étapes,<br />une aventure.</em></h2><p>Pékin, le kung-fu, Shanghai. Le premier voyage RAHAL réunit découverte du pays, apprentissage et vie à neuf.</p><div class="route-tags"><span>Pékin</span><span aria-hidden="true">→</span><span>Kung-fu</span><span aria-hidden="true">→</span><span>Shanghai</span></div></div>
    <div class="trip-ticket"><div class="ticket-top"><p>CHINE / {next.name}</p><span>Janvier 2027</span></div>
      <dl><div><dt>Départ</dt><dd>{next.dates}</dd></div><div><dt>Sur place</dt><dd>{next.duration} · du 9 au 18 janvier</dd></div><div><dt>Le groupe</dt><dd>{next.groupSize}</dd></div></dl>
      <div class="ticket-price"><strong>{next.price}</strong><span>Hors vols internationaux</span></div>
      <p class="ticket-payment">En 1 à 3 fois sans frais <span>· 3 × 630 €</span></p>
      <a class="btn btn--block" href={`/experiences/${next.slug}`}>Explorer le voyage <Arrow /></a><a class="ticket-programme" href={`/experiences/${next.slug}#etapes`}>Lire le programme jour par jour</a>
    </div>
  </div></section>}
  <section class="founder-note container section" aria-labelledby="founder-title">
    <div class="founder-seal" aria-hidden="true"><span>RAHAL</span><span class="seal-sun">✳</span><small>L’envie de transmettre.</small></div>
    <div><p class="kicker">Yassine · Fondateur de RAHAL</p><h2 id="founder-title">{accueil.founder.title}</h2><p>{accueil.founder.text}</p><a class="link-arrow" href="/a-propos">Découvrir l’histoire de RAHAL <Arrow /></a></div>
  </section>
  <section class="brand-closing section"><div class="container"><p class="kicker">Le début de l’aventure</p><h2>La prochaine histoire<br /><em>se vit peut-être avec toi.</em></h2><a class="btn btn--light" href="/experiences/chine#etapes">Voir le programme de la Chine <Arrow /></a></div></section>
</Base>

<style>
  .brand-hero{display:grid;gap:3.5rem;padding-block:clamp(3rem,7vw,6rem);align-items:center}
  .brand-copy{display:grid;gap:1.5rem;min-width:0}.brand-copy h1{font-family:var(--font-serif);font-weight:500;font-size:clamp(3.5rem,6.6vw,6.1rem);line-height:.99;letter-spacing:-.04em}.brand-copy h1 em{color:#875430;font-weight:400}.brand-lede{font-size:clamp(1.1rem,1.5vw,1.3rem);line-height:1.55}.brand-intro{max-width:31rem;color:var(--c-gris);font-size:.98rem}.brand-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1.25rem;margin-top:.4rem}.brand-link{font-size:.9rem;text-underline-offset:.35rem}.brand-signature{display:flex;align-items:center;gap:.7rem;font-size:.78rem;color:var(--c-gris);margin-top:.75rem}.brand-signature span{color:#875430;font-size:1.6rem}.desktop-break{display:none}
  .travel-poster{position:relative;display:flex;flex-direction:column;min-height:34rem;background:#254139;color:#f7f3eb;border-radius:45% 45% 1rem 1rem / 29% 29% 1rem 1rem;text-decoration:none;padding:4.5rem 2rem 1.5rem;overflow:hidden;box-shadow:15px 20px 0 #e8ddcc}.poster-top{display:flex;justify-content:space-between;gap:1rem;font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;padding-inline:1rem}.poster-title{font-family:var(--font-serif);font-size:5.5rem;line-height:.95;margin-top:2rem;position:relative;z-index:1}.poster-title em{display:block;font-size:3.5rem;font-weight:400;color:#e9bd72}.poster-art{width:100%;flex:1;margin-top:-4rem;min-height:18rem}.poster-bottom{display:flex;justify-content:space-between;border-top:1px solid #9cab9b;padding-top:1rem;font-size:.8rem;letter-spacing:.03em}.poster-bottom span span{margin-left:.7rem;font-size:1.3rem}.travel-poster:focus-visible{outline-color:#a1672c;outline-offset:7px}
  .brand-ribbon{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem 2rem;padding:1.2rem var(--gutter);border-block:1px solid var(--c-sable-3);font-size:.78rem;letter-spacing:.03em}.brand-ribbon span:nth-child(2){color:#875430}
  .section-intro{display:grid;gap:1rem}.manifesto h2,.next-heading h2,.founder-note h2,.brand-closing h2{font-family:var(--font-serif);font-weight:500;font-size:clamp(2.5rem,4.7vw,4.3rem);line-height:1.06;letter-spacing:-.025em}.manifesto h2 em,.next-heading h2 em{color:#875430;font-weight:400}.brand-pillars{display:grid;gap:2rem;margin-top:3rem}.brand-pillars article{border-top:1px solid var(--c-sable-3);padding-top:1.5rem}.chapter-number{font-family:var(--font-serif);font-size:2rem;font-style:italic;color:#875430}.brand-pillars h3{font-size:1.1rem;margin-block:1rem .6rem}.brand-pillars p{color:var(--c-gris);font-size:.98rem;max-width:32rem}
  .next-trip{background:#eae1d1}.next-grid{display:grid;gap:2.5rem;align-items:center}.next-heading{display:grid;gap:1.5rem}.next-heading>p:not(.kicker){max-width:30rem;color:var(--c-gris)}.route-tags{display:flex;gap:.6rem;flex-wrap:wrap;font-size:.76rem;align-items:center}.route-tags span:nth-child(odd){border:1px solid #b5a58c;padding:.4rem .8rem;border-radius:20rem}
  .trip-ticket{background:#fffdf8;border:1px solid var(--c-sable-3);border-radius:1rem;padding:clamp(1.3rem,3vw,2.5rem);box-shadow:0 15px 40px #4437230a}.ticket-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;font-size:.68rem;letter-spacing:.1em;font-weight:700;border-bottom:1px dashed #cfc2aa;padding-bottom:1.25rem}.ticket-top span{color:#875430}.trip-ticket dl{display:grid;gap:1rem;margin-block:1.5rem}.trip-ticket dl>div{display:flex;gap:1.5rem;justify-content:space-between}.trip-ticket dt{font-size:.8rem;color:var(--c-gris)}.trip-ticket dd{margin:0;text-align:right;font-size:.85rem;font-weight:650}.ticket-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:.6rem 1rem;border-top:1px dashed #cfc2aa;padding-top:1.25rem}.ticket-price strong{font-size:2.7rem;letter-spacing:-.055em}.ticket-price>span{font-size:.74rem;color:var(--c-gris)}.ticket-payment{font-size:.8rem;color:#365549;margin-block:.15rem 1.5rem;font-weight:650}.ticket-payment span{white-space:nowrap}.ticket-programme{display:block;text-align:center;font-size:.78rem;margin-top:1rem;text-underline-offset:.3rem}
  .founder-note{display:grid;gap:2.5rem;align-items:center}.founder-note>div:last-child{display:grid;gap:1.3rem}.founder-note p:not(.kicker){color:var(--c-gris);max-width:43rem}.founder-note .link-arrow{justify-self:start;font-size:.9rem}.founder-seal{min-height:16rem;aspect-ratio:1;display:flex;flex-direction:column;justify-content:center;align-items:center;border:1px solid #caba9f;border-radius:50%;color:#875430;max-width:20rem;margin:auto;width:100%;background:radial-gradient(circle,#e8ddcc 0,transparent 70%)}.founder-seal>span:first-child{letter-spacing:.35em;font-size:1.5rem;font-weight:800}.seal-sun{font-size:5rem;line-height:1.5}.founder-seal small{font-size:.73rem}.brand-closing{background:#254139;color:#f7f3eb;text-align:center}.brand-closing .container{display:grid;justify-items:center;gap:1.8rem}.brand-closing .kicker{color:#e9bd72}.brand-closing h2 em{font-weight:400;color:#e9bd72}
  @media(min-width:64rem){.brand-hero{grid-template-columns:1.25fr 1fr;gap:4rem}.desktop-break{display:block}.travel-poster{min-height:39rem}.poster-title{font-size:6.2rem}.poster-art{margin-top:-4rem}.brand-pillars{grid-template-columns:repeat(3,1fr);gap:3rem}.next-grid{grid-template-columns:1fr 1fr;gap:6rem}.founder-note{grid-template-columns:.65fr 1.35fr;gap:5rem}}
  @media(max-width:30rem){.brand-actions .btn{width:100%;font-size:.82rem;padding-inline:1rem}.travel-poster{min-height:31rem;box-shadow:8px 12px 0 #e8ddcc}.poster-top{font-size:.56rem;padding:0}.poster-title{font-size:4.8rem}.trip-ticket dl>div{gap:.7rem}.brand-ribbon{font-size:.7rem}}
</style>
