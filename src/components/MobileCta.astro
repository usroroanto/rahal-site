---
/**
 * Bouton fixe « Recevoir le programme » sur mobile.
 * Se masque quand le formulaire est visible ; le contenu garde une marge basse pour ne jamais être caché.
 */
import Arrow from './Arrow.astro';

interface Props {
  label?: string;
  target?: string;
}
const { label = 'Recevoir le programme', target = '#programme' } = Astro.props;
---

<div class="mobile-cta" data-mobile-cta data-target={target}>
  <a class="btn btn--block mobile-cta__btn" href={target}>
    {label}
    <Arrow />
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const target = bar?.dataset.target ? document.querySelector(bar.dataset.target) : null;
  if (bar && target && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) bar.toggleAttribute('data-hidden', entry.isIntersecting);
      },
      { threshold: 0.15 },
    );
    observer.observe(target);
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, rgb(247 243 235 / 0.98), rgb(247 243 235 / 0.9));
    border-top: 1px solid rgb(217 203 179 / 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform var(--t-base) var(--ease-out),
      opacity var(--t-base) var(--ease-out);
  }

  .mobile-cta[data-hidden] {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
  }

  .mobile-cta__btn {
    box-shadow: var(--shadow-m);
  }

  :global(body.has-mobile-cta) {
    padding-bottom: 5.5rem;
  }

  @media (min-width: 64rem) {
    .mobile-cta {
      display: none;
    }

    :global(body.has-mobile-cta) {
      padding-bottom: 0;
    }
  }
</style>
