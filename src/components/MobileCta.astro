---
/**
 * Bouton fixe en bas d'écran sur mobile.
 * Se masque quand l'une des sections observées (`target`, sélecteur CSS, éventuellement multiple) est visible ;
 * le contenu garde une marge basse pour ne jamais être caché.
 */
import Arrow from './Arrow.astro';

interface Props {
  label?: string;
  /** Section(s) observée(s) : le bouton disparaît quand l'une d'elles est à l'écran (ex. `#tarif, #demande`). */
  target?: string;
  /** Destination du bouton. Par défaut, la première section observée. */
  href?: string;
}
const { label = 'Faire ma demande', target = '#demande', href } = Astro.props;
const link = href ?? target.split(',')[0]?.trim() ?? target;
---

<div class="mobile-cta" data-mobile-cta data-target={target}>
  <a class="btn btn--block mobile-cta__btn" href={link}>
    {label}
    <Arrow />
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  let targets: Element[] = [];
  try {
    targets = bar?.dataset.target ? [...document.querySelectorAll(bar.dataset.target)] : [];
  } catch {
    targets = [];
  }
  if (bar && targets.length > 0 && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        const hidden = visible.size > 0;
        bar.toggleAttribute('data-hidden', hidden);
        // Masqué : ni cliquable, ni atteignable au clavier, ni lu par les lecteurs d'écran.
        bar.inert = hidden;
      },
      { threshold: 0.15 },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, rgb(247 243 235 / 0.98), rgb(247 243 235 / 0.9));
    border-top: 1px solid rgb(217 203 179 / 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform var(--t-base) var(--ease-out),
      opacity var(--t-base) var(--ease-out);
  }

  .mobile-cta[data-hidden] {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      transform var(--t-base) var(--ease-out),
      opacity var(--t-base) var(--ease-out),
      visibility 0s linear var(--t-base);
  }

  .mobile-cta__btn {
    box-shadow: var(--shadow-m);
  }

  :global(body.has-mobile-cta) {
    padding-bottom: 5.5rem;
  }

  /* Le champ ou lien qui reçoit le focus ne passe pas sous la barre fixe. */
  @media (max-width: 63.99rem) {
    :global(html:has(body.has-mobile-cta)) {
      scroll-padding-bottom: 6rem;
    }
  }

  @media (min-width: 64rem) {
    .mobile-cta {
      display: none;
    }

    :global(body.has-mobile-cta) {
      padding-bottom: 0;
    }
  }
</style>
