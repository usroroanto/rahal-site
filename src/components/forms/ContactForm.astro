---
/** Formulaire de contact (page FAQ / Contact). Envoi vers /api/contact (email via Brevo). */
import Arrow from '../Arrow.astro';
import SunMark from '../SunMark.astro';

interface Props {
  subjects: readonly string[];
}
const { subjects } = Astro.props;
---

<div class="contact-form" data-form-root="contact">
  <form class="form" method="post" action="/api/contact" novalidate>
    <div class="honeypot" aria-hidden="true">
      <label>Ne pas remplir <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="form__row">
      <div class="field">
        <label class="field__label" for="contact-prenom">Prénom</label>
        <input class="input" id="contact-prenom" name="prenom" type="text" autocomplete="given-name" required aria-describedby="contact-prenom-erreur" />
        <p class="field__error" id="contact-prenom-erreur" data-error-for="prenom"></p>
      </div>
      <div class="field">
        <label class="field__label" for="contact-email">Email</label>
        <input class="input" id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="contact-email-erreur" />
        <p class="field__error" id="contact-email-erreur" data-error-for="email"></p>
      </div>
    </div>

    <div class="field">
      <label class="field__label" for="contact-sujet">Sujet</label>
      <select class="input" id="contact-sujet" name="sujet" required aria-describedby="contact-sujet-erreur">
        <option value="">Choisis un sujet</option>
        {subjects.map((s) => <option value={s}>{s}</option>)}
      </select>
      <p class="field__error" id="contact-sujet-erreur" data-error-for="sujet"></p>
    </div>

    <div class="field">
      <label class="field__label" for="contact-message">Message</label>
      <textarea class="input" id="contact-message" name="message" rows="6" required aria-describedby="contact-message-erreur"></textarea>
      <p class="field__error" id="contact-message-erreur" data-error-for="message"></p>
    </div>

    <p class="form-status" role="status" aria-live="polite" data-status></p>

    <button class="btn" type="submit" data-submit>
      <span data-submit-label>Envoyer le message</span>
      <Arrow />
    </button>
  </form>

  <div class="success" hidden data-success>
    <SunMark size={36} />
    <h3 class="h3" tabindex="-1">Message envoyé !</h3>
    <p><span data-success-name>Merci. </span>On te répond dès que possible, à l’adresse que tu as indiquée.</p>
    <a hidden data-success-link href="#">Lien</a>
  </div>
</div>

<script>
  import { enhanceForm } from '@/scripts/enhance-form';
  enhanceForm('contact');
</script>

<style>
  .form {
    display: grid;
    gap: 1.25rem;
  }

  .form__row {
    display: grid;
    gap: 1.25rem;
  }

  .success[hidden],
  .form[hidden] {
    display: none;
  }

  .success {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--r-l);
    background: var(--c-sable);
  }

  .success h3:focus {
    outline: none;
  }

  .success a[hidden] {
    display: none;
  }

  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
