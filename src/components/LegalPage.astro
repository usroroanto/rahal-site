---
/** Gabarit simple pour les pages d'informations (confidentialité, mentions légales). */
import Base from '@/layouts/Base.astro';

interface Props {
  title: string;
  seo: { title: string; description: string };
  paragraphs: readonly string[];
}
const { title, seo, paragraphs } = Astro.props;
---

<Base title={seo.title} description={seo.description}>
  <section class="legal section">
    <div class="container">
      <h1 class="h-serif legal__title">{title}</h1>
      <div class="prose legal__body">
        {paragraphs.map((p) => <p>{p}</p>)}
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal__title {
    margin-bottom: 2rem;
  }

  .legal__body {
    color: var(--c-encre);
  }
</style>
