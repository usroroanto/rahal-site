---
/** En-tête de section : petit label doré, titre, chapeau. */
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  /** Niveau de titre HTML. */
  level?: 'h1' | 'h2' | 'h3';
  /** Titre en Cormorant (éditorial) plutôt qu'en Manrope. */
  serif?: boolean;
  align?: 'start' | 'center';
  class?: string;
}
const { kicker, title, lede, level = 'h2', serif = false, align = 'start', class: className } = Astro.props;
const Heading = level;
---

<div class:list={['section-head', { 'section-head--center': align === 'center' }, className]}>
  {kicker && <p class="kicker">{kicker}</p>}
  <Heading class={serif ? 'h-serif' : 'h2'}>{title}</Heading>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>

<style>
  .section-head--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
</style>
