---
/**
 * FAQ propre au séjour : titre, photo et lien de contact à gauche, questions à droite.
 * Masquée si aucune question n'est renseignée.
 */
import type { Faq, ImageRef } from '@/content/types';
import Arrow from '../Arrow.astro';
import FaqList from '../FaqList.astro';
import Photo from '../Photo.astro';

interface Props {
  items?: Faq[];
}
const { items = [] } = Astro.props;

const photo: ImageRef = {
  src: 'chine/muraille-creneaux.jpg',
  alt: 'Vue sur les montagnes boisées depuis les créneaux de la Grande Muraille, sous un ciel bleu.',
  position: 'center center',
  mobilePosition: 'center 48%',
};
---

{
  items.length > 0 && (
    <section class="xfaq" id="questions" aria-labelledby="xfaq-titre">
      <div class="container xfaq__inner">
        <div class="xfaq__aside">
          <div class="xfaq__head">
            <p class="kicker">Questions</p>
            <h2 class="h-serif xfaq__title" id="xfaq-titre">
              Avant de <em>te lancer.</em>
            </h2>
          </div>
          <Photo
            image={photo}
            ratio="4 / 5"
            rounded
            class="xfaq__photo"
            sizes="(min-width: 76rem) 360px, (min-width: 64rem) 30vw, calc(100vw - 2.5rem)"
          />
        </div>
        <div class="xfaq__list" data-reveal>
          <FaqList items={items} id="faq-sejour" />
        </div>
        <a class="link-arrow xfaq__contact" href="/faq-contact#contact">
          Une autre question&nbsp;? Écris-nous
          <Arrow class="" />
        </a>
      </div>
    </section>
  )
}

<style>
  .xfaq {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .xfaq__inner {
    display: grid;
    gap: 1.75rem;
  }

  .xfaq__aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }

  .xfaq__head {
    display: grid;
    gap: 0.9rem;
  }

  .xfaq__title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    text-wrap: balance;
  }

  .xfaq__title em {
    color: var(--c-brun-2);
  }

  .xfaq__aside :global(.xfaq__photo) {
    width: 100%;
  }

  /* Mobile et tablette : la photo passe en bandeau */
  .xfaq__aside :global(.xfaq__photo .photo__frame) {
    aspect-ratio: 16 / 9;
  }

  .xfaq__aside :global(.xfaq__photo img) {
    object-position: var(--pos-m);
  }

  .xfaq__contact {
    justify-self: start;
    font-size: 0.95rem;
  }

  @media (min-width: 64rem) {
    /* Titre, photo et lien à gauche ; questions à droite */
    .xfaq__inner {
      /* Colonne de gauche plus étroite : la photo 4/5 ne dépasse pas trop la liste des questions. */
      grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.34fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'aside list'
        'contact list';
      column-gap: clamp(3rem, 5vw, 4.5rem);
      row-gap: 1.25rem;
      align-items: start;
    }

    .xfaq__aside {
      grid-area: aside;
    }

    .xfaq__contact {
      grid-area: contact;
    }

    .xfaq__aside :global(.xfaq__photo .photo__frame) {
      aspect-ratio: 4 / 5;
    }

    .xfaq__aside :global(.xfaq__photo img) {
      object-position: var(--pos);
    }

    .xfaq__list {
      grid-area: list;
      padding-top: 0.5rem;
    }
  }
</style>
