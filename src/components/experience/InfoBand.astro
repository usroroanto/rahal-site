---
/** Bandeau d'informations du séjour : dates, durée, groupe, prix (formulations honnêtes si non confirmés). */
import type { Experience } from '@/content/types';

interface Props {
  experience: Experience;
}
const { experience: exp } = Astro.props;

const cells = [
  { label: 'Dates', value: exp.dates ?? 'À venir', confirmed: Boolean(exp.dates) },
  { label: 'Durée', value: exp.duration ?? 'Précisée avec le programme', confirmed: Boolean(exp.duration) },
  { label: 'Groupe', value: exp.groupSize ?? 'Petit groupe', confirmed: Boolean(exp.groupSize) },
  { label: 'Prix', value: exp.price ?? 'Communiqué avec le programme', confirmed: Boolean(exp.price), note: exp.priceNote },
];
---

<section class="band" aria-label="Informations clés du séjour">
  <div class="container">
    <dl class="band__grid">
      {
        cells.map((cell) => (
          <div class:list={['band__cell', { 'band__cell--pending': !cell.confirmed }]}>
            <dt>{cell.label}</dt>
            <dd>
              {cell.value}
              {cell.note && <span class="band__note">{cell.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .band {
    background: var(--c-sable);
    border-block: 1px solid var(--c-sable-3);
  }

  .band__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .band__cell {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgb(128 96 57 / 0.18);
  }

  .band__cell:nth-child(odd) {
    padding-right: 1rem;
    border-right: 1px solid rgb(128 96 57 / 0.18);
  }

  .band__cell:nth-child(even) {
    padding-left: 1rem;
  }

  .band__cell:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .band__cell dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-encre);
    opacity: 0.7;
    margin-bottom: 0.35rem;
  }

  .band__cell dd {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .band__cell--pending dd {
    font-weight: 500;
    color: var(--c-gris);
  }

  .band__note {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-gris);
  }

  @media (min-width: 48rem) {
    .band__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .band__cell,
    .band__cell:nth-child(odd),
    .band__cell:nth-child(even) {
      padding: 1.6rem 1.5rem;
      border-bottom: 0;
      border-right: 1px solid rgb(128 96 57 / 0.18);
    }

    .band__cell:first-child {
      padding-left: 0;
    }

    .band__cell:last-child {
      border-right: 0;
    }
  }
</style>
