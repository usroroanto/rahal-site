---
/** Informations pratiques du séjour (niveau, école, hébergement, repas, transports, rôle de Yassine). */
import type { PracticalItem } from '@/content/types';
import SectionHead from '../SectionHead.astro';
import SunMark from '../SunMark.astro';

interface Props {
  items: PracticalItem[];
}
const { items } = Astro.props;
---

<section class="practical section" id="pratique" aria-labelledby="pratique-titre">
  <div class="container">
    <SectionHead kicker="Informations pratiques" title="Ce qu’il faut savoir avant de partir." level="h2" />
    <div class="practical__grid">
      {
        items.map((item, i) => (
          <article class="practical__item" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <SunMark size={16} class="practical__sun" />
            <h3 class="practical__title">{item.title}</h3>
            <p class="practical__text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .practical__grid {
    display: grid;
    gap: 1.25rem;
  }

  .practical__item {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border-radius: var(--r-m);
    background: #fffdf9;
    border: 1px solid var(--c-sable-3);
  }

  .practical__title {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .practical__text {
    color: var(--c-gris);
    font-size: 0.98rem;
  }

  @media (min-width: 48rem) {
    .practical__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .practical__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
