---
/**
 * Ouverture de la page du séjour : grande photo plein cadre, voile vert forêt,
 * titre ivoire et carte « Le voyage en un regard ».
 * Mobile : photo en haut, texte posé sur le dégradé, carte en dessous.
 */
import type { Experience } from '@/content/types';
import Arrow from '../Arrow.astro';
import BrandMark from '../BrandMark.astro';
import Photo from '../Photo.astro';

interface Props {
  experience: Experience;
}
const { experience: exp } = Astro.props;

// Itinéraire tiré des étapes du programme (« 8–10 janvier · Pékin » → « Pékin »).
const stops = (exp.programme?.steps ?? [])
  .map((step) => {
    const parts = step.kicker?.split(/\s+·\s+/) ?? [];
    return parts.length > 1 ? parts.at(-1)?.trim() : undefined;
  })
  .filter((stop): stop is string => Boolean(stop));
const route = stops.length > 0 ? stops : [exp.country];
const lead = exp.country === 'Chine' ? 'La Chine,' : `${exp.country},`;
---

<section class="jhero on-dark" aria-labelledby="jhero-titre">
  <div class="jhero__media">
    <Photo image={exp.hero} priority fill sizes="100vw" />
  </div>
  <div class="jhero__veil" aria-hidden="true"></div>

  <div class="container jhero__inner">
    <div class="jhero__heading">
      <a class="jhero__back" href="/experiences"><span aria-hidden="true">←</span> Les voyages RAHAL</a>
      <p class="kicker">Le prochain départ · {exp.name}</p>
      <h1 class="jhero__title" id="jhero-titre">{lead}<br /><em>à vivre ensemble.</em></h1>
      <p class="jhero__lede">{exp.tagline}</p>
      <div class="jhero__actions">
        <a class="btn btn--light" href="#etapes">
          Explorer le programme
          <Arrow />
        </a>
        {
          exp.applicationUrl && (
            <a class="btn btn--ghost-light" href={exp.applicationUrl}>
              Faire ma demande
            </a>
          )
        }
      </div>
    </div>

    <aside class="jcard" aria-label="Le voyage en un regard">
      <div class="jcard__top">
        <span>RAHAL / 01</span>
        <BrandMark variant="light" height={40} />
      </div>
      <ol class="jcard__route" role="list" aria-label="Itinéraire">
        {
          route.map((stop, i) => (
            <li>
              {i > 0 && (
                <span class="jcard__arrow" aria-hidden="true">
                  ↓
                </span>
              )}
              {stop}
            </li>
          ))
        }
      </ol>
      {
        exp.price && (
          <>
            <p class="jcard__fare">
              <strong>{exp.price}</strong>
              <span>Hors vols internationaux</span>
            </p>
            <p class="jcard__pay">En 3 fois sans frais</p>
          </>
        )
      }
      {
        exp.pricing && (
          <a class="jcard__link" href="#tarif">
            Voir le tarif
            <Arrow class="" />
          </a>
        )
      }
    </aside>
  </div>
</section>

<style>
  .jhero {
    /* Hauteur de la photo sur mobile et part du texte posée sur son dégradé */
    --photo-h: clamp(18rem, 54svh, 30rem);
    --overlap: 6rem;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-foret-2);
    color: var(--c-ivoire);
  }

  .jhero__media,
  .jhero__veil {
    position: absolute;
    inset: 0 0 auto;
    height: var(--photo-h);
    z-index: -1;
  }

  .jhero__media :global(.photo__frame) {
    background: var(--c-foret-2);
  }

  /* Dégradé calé sur le bas de la photo : le texte posé dessus reste toujours sur un fond sombre. */
  .jhero__veil {
    background: linear-gradient(
      to bottom,
      rgb(27 48 41 / 0) calc(100% - var(--overlap) - 9rem),
      rgb(27 48 41 / 0.6) calc(100% - var(--overlap) - 2rem),
      rgb(27 48 41 / 0.88) calc(100% - var(--overlap) + 0.5rem),
      var(--c-foret-2) 100%
    );
  }

  .jhero__inner {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-top: calc(var(--photo-h) - var(--overlap));
    padding-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* --- Titre ------------------------------------------------------------ */
  .jhero__heading {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 40rem;
    animation: jhero-in 0.9s var(--ease-out) both;
  }

  .jhero__back {
    display: inline-flex;
    gap: 0.45rem;
    padding-block: 0.2rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(247 243 235 / 0.88);
    text-decoration: none;
  }

  .jhero__back:hover {
    color: var(--c-ivoire);
    text-decoration: underline;
    text-decoration-color: var(--c-or-clair);
  }

  .jhero .kicker {
    color: var(--c-or-clair);
  }

  .jhero__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.9rem, 6.2vw + 0.5rem, 6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.25);
  }

  .jhero__title em {
    font-weight: 400;
    color: var(--c-or-clair);
  }

  .jhero__lede {
    max-width: 31rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: rgb(247 243 235 / 0.94);
    text-wrap: pretty;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.3);
  }

  .jhero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  /* --- Carte « Le voyage en un regard » --------------------------------- */
  .jcard {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--r-l);
    background: var(--c-foret);
    border: 1px solid rgb(233 189 114 / 0.24);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.28);
    animation: jhero-in 0.9s var(--ease-out) 0.12s both;
  }

  .jcard__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgb(247 243 235 / 0.82);
  }

  .jcard__route {
    list-style: none;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.85rem, 1.2rem + 1.6vw, 2.4rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .jcard__arrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--c-or-clair);
  }

  .jcard__fare {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(247 243 235 / 0.2);
  }

  .jcard__fare strong {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .jcard__fare span {
    font-size: 0.8rem;
    color: rgb(247 243 235 / 0.82);
  }

  .jcard__pay {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--c-or-clair);
  }

  .jcard__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-ivoire);
    text-decoration: underline;
    text-decoration-color: var(--c-or-clair);
    text-underline-offset: 0.3rem;
  }

  .jcard__link :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform var(--t-fast) var(--ease-out);
  }

  .jcard__link:hover :global(svg) {
    transform: translateX(3px);
  }

  @keyframes jhero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jhero__heading,
    .jcard {
      animation: none;
    }
  }

  /* Tablette : la carte se déploie sur deux colonnes plutôt que de s'étirer. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .jcard {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2.5rem;
    }

    .jcard__top {
      grid-column: 1 / -1;
    }

    .jcard__route {
      grid-column: 1;
      grid-row: 2 / span 3;
    }

    .jcard__fare {
      grid-column: 2;
      grid-row: 2;
    }

    .jcard__pay {
      grid-column: 2;
      grid-row: 3;
    }

    .jcard__link {
      grid-column: 2;
      grid-row: 4;
    }
  }

  /* Ordinateur : photo plein cadre, texte à gauche, carte à droite. */
  @media (min-width: 64rem) {
    .jhero {
      display: grid;
      /* Laisse deviner la suite de la page sous la photo */
      min-height: min(calc(100svh - var(--header-h) - 2.5rem), 50rem);
    }

    .jhero__media,
    .jhero__veil {
      inset: 0;
      height: auto;
    }

    /* Voile assez dense jusqu'au milieu : le titre passe au-dessus des toits jaunes (contraste ≥ 3:1 pour l'italique doré). */
    .jhero__veil {
      background:
        linear-gradient(
          90deg,
          rgb(27 48 41 / 0.92) 0%,
          rgb(27 48 41 / 0.84) 30%,
          rgb(27 48 41 / 0.72) 48%,
          rgb(27 48 41 / 0.45) 60%,
          rgb(27 48 41 / 0.15) 74%,
          rgb(27 48 41 / 0) 86%
        ),
        linear-gradient(to top, rgb(27 48 41 / 0.75) 0%, rgb(27 48 41 / 0) 45%);
    }

    .jhero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 23rem);
      align-content: end;
      align-items: end;
      gap: 4rem;
      padding-block: clamp(7rem, 18vh, 12rem) clamp(3rem, 6vh, 4.5rem);
    }

    .jhero__heading {
      gap: 1.15rem;
    }
  }
</style>
