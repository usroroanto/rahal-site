---
/** Programme par étapes, avec photos et détail jour par jour dépliable. */
import type { Experience } from '@/content/types';
import Photo from '../Photo.astro';
import SectionHead from '../SectionHead.astro';
import SunMark from '../SunMark.astro';
import Arrow from '../Arrow.astro';

interface Props {
  experience: Experience;
}
const { experience: exp } = Astro.props;
const steps = exp.programme?.steps ?? [];
---

<section class="prog section section--sand" id="etapes" aria-labelledby="prog-titre">
  <div class="container">
    <SectionHead kicker="Le programme" title="Le séjour, étape par étape." lede={exp.programme?.intro} level="h2" />

    {
      steps.length > 0 ? (
        <ol class="steps" role="list">
          {steps.map((step, i) => (
            <li class="step" data-reveal>
              <div class="step__marker" aria-hidden="true">
                <SunMark size={18} />
              </div>
              <div class="step__body">
                {step.kicker && <p class="step__kicker">{step.kicker}</p>}
                <h3 class="step__title">
                  <span class="step__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {step.title}
                </h3>
                <p class="step__text">{step.text}</p>
                {step.image && (
                  <div class="step__media">
                    <Photo image={step.image} ratio="16 / 9" rounded sizes="(min-width: 64rem) 60vw, 100vw" />
                  </div>
                )}
                {step.days && step.days.length > 0 && (
                  <details class="days">
                    <summary class="days__summary">
                      <span>Voir le détail jour par jour</span>
                      <span class="days__icon" aria-hidden="true" />
                    </summary>
                    <ol class="days__list" role="list">
                      {step.days.map((day) => (
                        <li class="day">
                          <p class="day__title">{day.title}</p>
                          <p class="day__text">{day.text}</p>
                        </li>
                      ))}
                    </ol>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="prog__pending" data-reveal>
          <SunMark size={30} />
          <h3 class="h3">Programme détaillé prochainement disponible</h3>
          <p>
            Le déroulé jour par jour est en cours de finalisation. Demande le programme : tu le recevras par email dès sa
            publication, sans engagement.
          </p>
          <a class="btn" href="#programme">
            Recevoir le programme
            <Arrow />
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    gap: 0;
    max-width: 52rem;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.25rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0.95rem;
    top: 1.75rem;
    bottom: 0;
    width: 1px;
    background: rgb(128 96 57 / 0.3);
  }

  .step:last-child::before {
    display: none;
  }

  .step__marker {
    position: relative;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-ivoire);
    border: 1px solid var(--c-sable-3);
  }

  .step__body {
    display: grid;
    gap: 0.75rem;
    padding-top: 0.2rem;
  }

  .step__kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-brun);
  }

  .step__title {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    line-height: 1.1;
  }

  .step__num {
    font-style: italic;
    color: var(--c-or);
    font-size: 0.8em;
  }

  .step__text {
    color: var(--c-gris);
    max-width: 40rem;
  }

  .step__media {
    margin-top: 0.5rem;
  }

  .days {
    margin-top: 0.5rem;
    border-radius: var(--r-m);
    background: var(--c-ivoire);
    border: 1px solid var(--c-sable-3);
  }

  .days__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: var(--r-m);
  }

  .days__summary::-webkit-details-marker {
    display: none;
  }

  .days__icon {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    border: 1px solid var(--c-sable-3);
    flex: none;
  }

  .days__icon::before,
  .days__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.6rem;
    height: 1.5px;
    background: var(--c-encre);
    transform: translate(-50%, -50%);
    transition: transform var(--t-base) var(--ease-out);
  }

  .days__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .days[open] .days__icon::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .days__list {
    list-style: none;
    display: grid;
    gap: 1rem;
    padding: 0 1.1rem 1.1rem;
  }

  .day {
    display: grid;
    gap: 0.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--c-sable-3);
  }

  .day__title {
    font-weight: 700;
  }

  .day__text {
    color: var(--c-gris);
    font-size: 0.97rem;
  }

  .prog__pending {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 36rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--r-l);
    background: var(--c-ivoire);
    border: 1px solid var(--c-sable-3);
  }

  .prog__pending p {
    color: var(--c-gris);
  }
</style>
