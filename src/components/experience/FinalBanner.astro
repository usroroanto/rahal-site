---
/** Dernier appel de la page du séjour : photo plein cadre de nuit, voile sombre, demande et contact. */
import type { Experience, ImageRef } from '@/content/types';
import Arrow from '../Arrow.astro';
import Photo from '../Photo.astro';

interface Props {
  experience: Experience;
}
const { experience: exp } = Astro.props;

// Photo décorative : cadrée sur la porte illuminée.
const photo: ImageRef = {
  src: 'chine/porte-shaolin.jpg',
  alt: '',
  position: 'center 25%',
  mobilePosition: 'center 30%',
};
---

<section class="xfinal on-dark" id="demande" aria-labelledby="xfinal-titre">
  <div class="xfinal__media">
    <Photo image={photo} fill sizes="100vw" />
  </div>
  <div class="xfinal__veil" aria-hidden="true"></div>

  <div class="container xfinal__inner" data-reveal>
    <h2 class="h-serif xfinal__title" id="xfinal-titre">Prêt(e) à vivre <em>l’expérience&nbsp;?</em></h2>
    <p class="xfinal__text">Une demande en quelques minutes, sans paiement à cette étape : l’acompte n’est demandé qu’après validation.</p>
    <div class="xfinal__actions">
      {
        exp.applicationUrl && (
          <a class="btn btn--light" href={exp.applicationUrl}>
            Faire ma demande
            <Arrow />
          </a>
        )
      }
      <a class="btn btn--ghost-light" href="/faq-contact#contact">Une question&nbsp;? Écris-nous</a>
    </div>
  </div>
</section>

<style>
  .xfinal {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 78svh, 40rem);
    background: var(--c-encre);
    color: var(--c-ivoire);
  }

  .xfinal__media,
  .xfinal__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .xfinal__media :global(.photo__frame) {
    background: var(--c-encre);
  }

  /* Mobile et tablette : le texte passe sur les colonnes orange de la porte, le voile reste dense jusqu'aux deux tiers. */
  .xfinal__veil {
    background: linear-gradient(
      to top,
      rgb(34 33 31 / 0.95) 0%,
      rgb(34 33 31 / 0.85) 40%,
      rgb(34 33 31 / 0.6) 65%,
      rgb(34 33 31 / 0.3) 85%,
      rgb(34 33 31 / 0.15) 100%
    );
  }

  .xfinal__inner {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .xfinal__title {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.3);
  }

  .xfinal__title em {
    color: var(--c-or-clair);
  }

  .xfinal__text {
    max-width: 30rem;
    font-size: 1.1rem;
    color: rgb(247 243 235 / 0.92);
    text-wrap: pretty;
  }

  .xfinal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 64rem) {
    .xfinal {
      align-items: center;
    }

    .xfinal__veil {
      background:
        linear-gradient(
          90deg,
          rgb(27 48 41 / 0.9) 0%,
          rgb(34 33 31 / 0.72) 42%,
          rgb(34 33 31 / 0.3) 75%,
          rgb(34 33 31 / 0.15) 100%
        ),
        linear-gradient(to top, rgb(34 33 31 / 0.5) 0%, rgb(34 33 31 / 0) 40%);
    }
  }
</style>
