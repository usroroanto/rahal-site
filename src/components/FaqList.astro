---
/** Liste de questions / réponses en accordéons natifs (<details>), accessibles au clavier. */
import type { Faq } from '@/content/types';
import Arrow from './Arrow.astro';

interface Props {
  items: readonly Faq[];
  /** Préfixe des identifiants (utile s'il y a plusieurs listes sur une page). */
  id?: string;
  class?: string;
}
const { items, id = 'faq', class: className } = Astro.props;
---

<div class:list={['faq', className]}>
  {
    items.map((item, i) => (
      <details class="faq__item" id={`${id}-${i + 1}`}>
        <summary class="faq__summary">
          <span class="faq__question">{item.question}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__body">
          <p>{item.answer}</p>
          {item.link && (
            <a class="link-arrow faq__link" href={item.link.href}>
              {item.link.label}
              <Arrow class="" />
            </a>
          )}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    border-top: 1px solid var(--c-sable-3);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-sable-3);
  }

  .faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    border-radius: var(--r-s);
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__summary:hover .faq__question {
    color: var(--c-brun);
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--c-sable-3);
    transition:
      background-color var(--t-fast) var(--ease-out),
      transform var(--t-base) var(--ease-out);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.7rem;
    height: 1.5px;
    background: var(--c-encre);
    transform: translate(-50%, -50%);
    transition: transform var(--t-base) var(--ease-out);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__icon {
    background: var(--c-encre);
    border-color: var(--c-encre);
  }

  .faq__item[open] .faq__icon::before,
  .faq__item[open] .faq__icon::after {
    background: var(--c-ivoire);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__body {
    display: grid;
    gap: 0.9rem;
    padding: 0 0.25rem 1.4rem;
    max-width: var(--w-text);
    color: var(--c-gris);
    animation: faq-in var(--t-base) var(--ease-out);
  }

  .faq__link {
    width: fit-content;
    color: var(--c-encre);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
