---
/**
 * Photo responsive avec cadrage spécifique mobile / ordinateur.
 * Rend une image optimisée si le fichier existe, sinon un visuel de substitution.
 */
import { Image } from 'astro:assets';
import type { ImageRef } from '@/content/types';
import { resolveImage } from '@/lib/images';
import Placeholder from './Placeholder.astro';

interface Props {
  image: ImageRef;
  /** Ratio CSS (ex. "4 / 5"). Sans ratio, l'image garde ses proportions. */
  ratio?: string;
  /** Ratio sur mobile, si différent. */
  mobileRatio?: string;
  /** Attribut `sizes` pour le srcset. */
  sizes?: string;
  /** Image prioritaire (au-dessus de la ligne de flottaison). */
  priority?: boolean;
  /** Affiche la légende (`image.caption`) sous la photo. */
  caption?: boolean;
  /** Arrondi des angles. */
  rounded?: boolean;
  /** L'image remplit son conteneur (ex. visuel d'ouverture), sans ratio imposé. */
  fill?: boolean;
  class?: string;
}

const {
  image,
  ratio,
  mobileRatio,
  sizes = '(min-width: 64rem) 50vw, 100vw',
  priority = false,
  caption = false,
  rounded = false,
  fill = false,
  class: className,
} = Astro.props;

const meta = resolveImage(image.src);
const style = [
  `--pos:${image.position ?? 'center'}`,
  `--pos-m:${image.mobilePosition ?? image.position ?? 'center'}`,
  ratio ? `--ratio:${ratio}` : '',
  mobileRatio ? `--ratio-m:${mobileRatio}` : '',
]
  .filter(Boolean)
  .join(';');
---

<figure
  class:list={['photo', { 'photo--rounded': rounded, 'photo--placeholder': !meta, 'photo--ratio': Boolean(ratio), 'photo--fill': fill }, className]}
  style={style}
>
  <div class="photo__frame">
    {
      meta ? (
        priority ? (
          <Image src={meta} alt={image.alt} sizes={sizes} priority />
        ) : (
          <Image src={meta} alt={image.alt} sizes={sizes} loading="lazy" />
        )
      ) : (
        <Placeholder seed={image.src} />
      )
    }
  </div>
  {caption && image.caption && <figcaption class="photo__caption">{image.caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .photo__frame {
    position: relative;
    overflow: hidden;
    background: var(--c-sable);
    aspect-ratio: var(--ratio-m, var(--ratio, auto));
  }

  .photo--placeholder .photo__frame {
    aspect-ratio: var(--ratio-m, var(--ratio, 4 / 3));
  }

  .photo--rounded .photo__frame {
    border-radius: var(--r-l);
  }

  .photo__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-m);
  }

  .photo--ratio .photo__frame :global(img) {
    position: absolute;
    inset: 0;
  }

  .photo__caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--c-gris);
  }

  @media (min-width: 48rem) {
    .photo__frame {
      aspect-ratio: var(--ratio, auto);
    }

    .photo--placeholder .photo__frame {
      aspect-ratio: var(--ratio, 4 / 3);
    }

    .photo__frame :global(img) {
      object-position: var(--pos);
    }
  }
  /* Mode remplissage : la photo couvre tout le conteneur parent. */
  .photo.photo--fill {
    height: 100%;
  }

  .photo.photo--fill .photo__frame {
    height: 100%;
    aspect-ratio: auto;
  }

  .photo.photo--fill .photo__frame :global(img),
  .photo.photo--fill .photo__frame :global(.placeholder) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
