---
/**
 * Logo RAHAL.
 * Utilise `src/assets/brand/logo.(svg|png|webp)` et, sur fond sombre, `logo-clair.*` (traits ivoire, disque doré inchangé).
 * Sans fichier, un mot-symbole typographique temporaire est affiché.
 */
import { Image } from 'astro:assets';
import { brandLogo, brandLogoLight } from '@/lib/images';
import SunMark from './SunMark.astro';

interface Props {
  variant?: 'dark' | 'light';
  /** Hauteur d'affichage en pixels (la largeur suit le ratio du logo). */
  height?: number;
  class?: string;
}
const { variant = 'dark', height = 48, class: className } = Astro.props;
const logo = variant === 'light' ? brandLogoLight : brandLogo;
const width = logo ? Math.round((logo.width / logo.height) * height) : undefined;
---

{
  logo ? (
    logo.format === 'svg' ? (
      <img class:list={['logo-img', className]} src={logo.src} alt="RAHAL" width={width} height={height} decoding="async" />
    ) : (
      <Image
        class:list={['logo-img', className]}
        src={logo}
        alt="RAHAL"
        width={width}
        height={height}
        densities={[1, 2, 3]}
        layout="none"
        quality={90}
      />
    )
  ) : (
    <span class:list={['wordmark', `wordmark--${variant}`, className]} style={`--logo-h:${height}px`}>
      <SunMark class="wordmark__sun" size={Math.round(height * 0.62)} />
      <span class="wordmark__text">RAHAL</span>
    </span>
  )
}

<style>
  .logo-img {
    display: block;
    height: auto;
    width: auto;
    max-height: 100%;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: var(--logo-h, 34px);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: calc(var(--logo-h, 34px) * 0.62);
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--c-encre);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wordmark--light {
    color: var(--c-ivoire);
  }

  .wordmark__text {
    padding-left: 0.05em;
    translate: 0 0.04em;
  }
</style>
