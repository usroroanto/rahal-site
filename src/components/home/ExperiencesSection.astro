---
/** Nos expériences : conçue pour accueillir plusieurs cartes, n'affiche que celles réellement renseignées. */
import { accueil } from '@/content/pages/accueil';
import { experiences } from '@/content/experiences';
import ExperienceCard from '../ExperienceCard.astro';
import SectionHead from '../SectionHead.astro';
import Arrow from '../Arrow.astro';

const { experiences: copy } = accueil;
const single = experiences.length === 1;
---

<section class="xps section section--sand" id="experiences" aria-labelledby="xps-titre">
  <div class="container">
    <div class="xps__head">
      <SectionHead kicker={copy.kicker} title={copy.title} lede={copy.text} level="h2" />
      {
        !single && (
          <a class="link-arrow xps__all" href="/experiences">
            {copy.cta}
            <Arrow class="" />
          </a>
        )
      }
    </div>

    <div class:list={['xps__grid', { 'xps__grid--single': single }]}>
      {experiences.map((exp) => <ExperienceCard experience={exp} variant={single ? 'feature' : 'grid'} />)}
    </div>

    {
      single && (
        <p class="xps__more" data-reveal>
          <a class="link-arrow" href="/experiences">
            {copy.cta}
            <Arrow class="" />
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .xps__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
  }

  .xps__head :global(.section-head) {
    margin-bottom: 0;
  }

  .xps__all {
    margin-bottom: 0.5rem;
  }

  .xps__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: var(--s-block);
  }

  .xps__more {
    margin-top: 2rem;
  }

  @media (min-width: 64rem) {
    .xps__grid:not(.xps__grid--single) {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
</style>
