---
/** Dernier appel à l'action : découvrir le programme du séjour en Chine. */
import { accueil } from '@/content/pages/accueil';
import Arrow from '../Arrow.astro';
import SunMark from '../SunMark.astro';
import Topo from '../Topo.astro';

const { finalCta } = accueil;
---

<section class="final section--dark on-dark" aria-labelledby="final-titre">
  <Topo class="final__topo" />
  <div class="container final__inner" data-reveal>
    <SunMark size={40} />
    <p class="kicker">{finalCta.kicker}</p>
    <h2 class="h-serif" id="final-titre">{finalCta.title}</h2>
    <p class="final__text">{finalCta.text}</p>
    <div class="final__actions">
      <a class="btn btn--light" href={finalCta.primary.href}>
        {finalCta.primary.label}
        <Arrow />
      </a>
      <a class="btn btn--ghost-light" href={finalCta.secondary.href}>{finalCta.secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    padding-block: var(--s-section);
  }

  .final :global(.final__topo) {
    --topo-color: var(--c-or);
    --topo-opacity: 0.14;
    inset: -10% -20% auto auto;
    width: 70%;
    height: 140%;
  }

  .final__inner {
    position: relative;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 44rem;
  }

  .final__text {
    font-size: 1.1rem;
    color: var(--c-sable);
    text-wrap: pretty;
  }

  .final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
